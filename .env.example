MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=CharityLife

# Origin this API is reachable at. The archiver treats media on this host as
# already ours; leaving it wrong makes every uploaded image get archived twice.
PUBLIC_URL=http://localhost:3000

# Origins allowed to call this API (comma-separated). A deployed frontend that
# is not listed here gets blocked by CORS on every request.
CORS_ORIGIN=http://localhost:5173

# Where the SPA lives — used for password-reset links in outgoing email.
FRONTEND_URL=http://localhost:5173

# Media storage. All uploads and archived external media go here — the app
# writes nothing to local disk, so an ephemeral host is fine.
CLOUDINARY_CLOUD_NAME=<cloud name>
CLOUDINARY_API_KEY=<api key>
CLOUDINARY_API_SECRET=<api secret>
CLOUDINARY_FOLDER=charitylife

# SMTP for confirmation and password-reset mail. Port 465 = implicit TLS;
# use 587 for STARTTLS. Registration deletes the new user if the confirmation
# email cannot be sent, so a wrong value here looks like signup doing nothing.
EMAIL_HOST=charitylife.org
EMAIL_PORT=465
EMAIL_USER=info@charitylife.org
EMAIL_PASS=
EMAIL_FROM=info@charitylife.org

JWT_SECRET=<a long random string>
PORT=3000
