MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=CharityLife

# Origin this API is reachable at. The archiver treats media on this host as
# already ours; leaving it wrong makes every uploaded image get archived twice.
PUBLIC_URL=http://localhost:3000

# Absolute path for uploaded media. Defaults to <cwd>/uploads when unset.
# On shared hosting, point this outside the app directory so a redeploy that
# replaces the app folder cannot delete the archive.
# UPLOAD_DIR=/home/<user>/media

JWT_SECRET=<a long random string>
PORT=3000
